# Copy this file to .env and fill in your own values.
# .env is in .gitignore, so it never gets committed.

# 1. Claude Console -> API keys  (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# 2. Todoist -> Settings -> Integrations -> Developer -> API token
TODOIST_API_TOKEN=

# 3. Telegram: token from @BotFather, chat id from scripts/get_telegram_chat_id.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
# BRIEF_NAME=Dan                          # whose brief it is (used in the prompt)
# MORNING_BRIEF_MODEL=claude-sonnet-5-5   # try claude-haiku-5-5 for cost
# GOOGLE_CALENDAR_ID=primary              # or a specific calendar's id
